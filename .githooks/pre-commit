#!/usr/bin/env bash
# Project rule: nothing committed upstream names the coding assistant used on this project. Rejects commits whose
# staged paths or added lines contain its name (the pattern is spelled as a character class so this file passes).
P='c[l]aude'
bad_paths=$(git diff --cached --name-only --diff-filter=ACMR | grep -i -E "$P")
bad_lines=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep -v '^+++' | grep -i -n -E "^\+.*$P" | head -5)
if [ -n "$bad_paths$bad_lines" ]; then
    echo "pre-commit: staged changes name the coding assistant; remove them before committing." >&2
    [ -n "$bad_paths" ] && echo "$bad_paths" >&2
    [ -n "$bad_lines" ] && echo "$bad_lines" | cut -c1-200 >&2
    exit 1
fi
